# Copy to .env (gitignored). Never commit real values.

# --- Agent -> signer ---
SIGNER_URL=http://127.0.0.1:8787
SIGNER_TOKEN=change-me-long-random          # shared bearer secret, agent <-> signer

# --- UsePod ---
USEPOD_BASE_URL=http://127.0.0.1:8402       # mock gateway; real: https://api.usepod.ai

# --- Budget (micro-USD; 1_000_000 = $1.00) ---
INFERENCE_LIFETIME_CEILING_MICRO=5000000    # $5.00 for the whole project, including network fees and deposits
INFERENCE_PHASE=P1                          # which allocation bucket new spend is charged to

# --- Signer only (never set these in the agent's environment) ---
SIGNER_RAIL=mock                            # mock | solana
SIGNER_KEYPAIR_PATH=keys/inference.keypair.json
SIGNER_JOURNAL_PATH=data/signer-journal.sqlite
SIGNER_LIFETIME_CEILING_MICRO=5000000
SIGNER_MAX_PER_CALL_MICRO=50000             # refuse any single payment above $0.05
SIGNER_SOL_USD_CEILING_PRICE=400            # conservative SOL price used to count network fees
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
