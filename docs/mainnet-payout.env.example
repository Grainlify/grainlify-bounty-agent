# Mainnet payout configuration for P3. OFF until both switches below are
# deliberately set to "yes". No secrets here; the keypair is a secret variable.

# --- payout signer ---
PAYOUT_NETWORK=solana-mainnet
PAYOUT_ALLOW_MAINNET=no                 # switch 1 of 2: the payout signer refuses to start on mainnet unless "yes"
PAYOUT_RPC_URL=https://api.mainnet-beta.solana.com
PAYOUT_MINTS={"USDC":{"mint":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","decimals":6}}
PAYOUT_JOURNAL_PATH=/data/payout-journal-mainnet.sqlite   # fresh journal, never the devnet one
PAYOUT_ALLOWED_REPOS=Grainlify/grainlify-agent-sandbox     # widen only after P3 sign-off
# PAYOUT_KEYPAIR_JSON=<secret variable>  float 6MUyKvy6k3rBLJNkGgM4NEMRGawxVCnryUheWFTCRE23

# --- agent ---
GATE_ALLOW_MAINNET=no                   # switch 2 of 2: the gate refuses mainnet bounties unless "yes"
# Caps are hard-coded: $50 per bounty, $150 per day, human approval for every payout.
